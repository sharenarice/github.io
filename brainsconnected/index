        <path d="M20.0 41.0 Q22.9 46.4 28.0 43.0 Q33.1 39.6 36.0 45.0 Q38.9 50.4 44.0 47.0" fill="none" stroke="#C7CBCF" stroke-width="2.4" stroke-linecap="round"/>
