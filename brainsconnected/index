<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>BrainsConnected: The Meeting Place for Consumer Neurotech Users</title>
<meta name="description" content="BrainsConnected is the friendly home of consumer neurotech: discover devices, connect with other users, and help invent what comes next.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Source+Sans+3:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --tan: #F5EDE1;
    --tan-deep: #EDE1D0;
    --coral: #C1694F;
    --coral-soft: #DDA391;
    --silver: #8B9199;
    --silver-light: #C7CBCF;
    --gold: #C9A84C;
    --gold-soft: #E3CD8E;
    --ink: #2B2620;
    --ink-soft: #5A5348;
    --white: #FFFFFF;
    --radius: 22px;
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }

  body {
    margin: 0;
    background: var(--tan);
    color: var(--ink);
    font-family: 'Source Sans 3', sans-serif;
    font-size: 17px;
    line-height: 1.6;
  }

  h1, h2, h3, h4 {
    font-family: 'Fraunces', serif;
    font-weight: 500;
    color: var(--ink);
    margin: 0 0 0.5em;
    letter-spacing: -0.01em;
  }

  a { color: var(--coral); text-decoration: none; }
  a:hover { color: #A5533C; }

  a:focus-visible, button:focus-visible {
    outline: 3px solid var(--gold);
    outline-offset: 3px;
    border-radius: 6px;
  }

  img { max-width: 100%; display: block; }

  .wrap { max-width: 1180px; margin: 0 auto; padding: 0 32px; }

  /* ---------- Header ---------- */

  header { padding: 26px 0 18px; }

  .header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }

  .brand { display: flex; align-items: center; gap: 15px; }

  .brand-mark { width: 54px; height: 54px; flex-shrink: 0; }

  .brand-text h1 { font-size: 1.65rem; margin: 0; line-height: 1; }
  .brand-text h1 .brand-brains { color: var(--coral); }
  .brand-text h1 .brand-connected { color: var(--gold); }
  .brand-text p {
    margin: 5px 0 0;
    font-size: 0.8rem;
    color: var(--ink-soft);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  nav ul {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 26px;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }
  nav a {
    color: var(--ink-soft);
    font-weight: 600;
    font-size: 0.94rem;
    padding-bottom: 4px;
    border-bottom: 2px solid transparent;
    transition: border-color 0.2s, color 0.2s;
  }
  nav a:hover { color: var(--coral); border-bottom-color: var(--gold); }

  .nav-join {
    background: var(--coral);
    color: var(--white) !important;
    padding: 10px 22px;
    border-radius: 999px;
    border-bottom: none !important;
    box-shadow: 0 5px 14px rgba(193, 105, 79, 0.22);
    transition: background 0.2s, transform 0.15s;
  }
  .nav-join:hover { background: #A5533C; transform: translateY(-1px); }

  /* ---------- Hero ---------- */

  .hero { position: relative; overflow: hidden; padding: 66px 0 60px; }

  .hero-net {
    position: absolute;
    top: 20px;
    right: -60px;
    width: 560px;
    max-width: 60vw;
    pointer-events: none;
  }

  .hero-inner { position: relative; z-index: 1; max-width: 660px; }

  .hero h2 {
    font-size: clamp(2rem, 4vw, 2.9rem);
    line-height: 1.18;
    margin-bottom: 0.4em;
  }
  .hero h2 .accent { color: var(--coral); }

  .hero p.lede {
    color: var(--ink-soft);
    font-size: 1.08rem;
    max-width: 600px;
  }

  .hero-ctas { display: flex; gap: 16px; flex-wrap: wrap; margin-top: 26px; align-items: center; }

  .btn-primary {
    display: inline-block;
    background: var(--coral);
    color: var(--white);
    padding: 15px 34px;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.98rem;
    box-shadow: 0 8px 20px rgba(193, 105, 79, 0.25);
    transition: transform 0.15s, box-shadow 0.15s, background 0.15s;
  }
  .btn-primary:hover {
    background: #A5533C;
    color: var(--white);
    transform: translateY(-1px);
    box-shadow: 0 10px 24px rgba(193, 105, 79, 0.32);
  }

  .btn-ghost {
    display: inline-block;
    color: var(--ink);
    font-weight: 600;
    font-size: 0.95rem;
    padding: 13px 26px;
    border-radius: 999px;
    border: 2px solid var(--silver-light);
    transition: border-color 0.2s, color 0.2s, background 0.2s;
  }
  .btn-ghost:hover { border-color: var(--gold); color: var(--coral); background: rgba(255,255,255,0.5); }

  /* ---------- Trust band ---------- */

  .trust-band {
    background: var(--white);
    border-radius: var(--radius);
    padding: 22px 30px;
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
    box-shadow: 0 2px 10px rgba(43, 38, 32, 0.05);
    margin-bottom: 64px;
  }
  .trust-band svg { flex-shrink: 0; }
  .trust-band p { margin: 0; color: var(--ink-soft); font-size: 0.98rem; flex: 1; min-width: 260px; }
  .trust-band p strong { color: var(--ink); }
  .trust-band a { font-weight: 600; white-space: nowrap; }

  /* ---------- Section headers ---------- */

  .section-heading {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin: 0 0 26px;
  }
  .section-heading h3 { font-size: 1.55rem; margin: 0; }
  .section-heading .rule {
    flex: 1;
    height: 1px;
    background: linear-gradient(to right, var(--gold), transparent);
  }

  .kicker {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 10px;
  }

  /* ---------- Article cards ---------- */

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(255px, 1fr));
    gap: 26px;
    padding-bottom: 70px;
  }

  .card {
    background: var(--white);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: 0 2px 10px rgba(43, 38, 32, 0.06);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    display: flex;
    flex-direction: column;
  }
  .card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 24px rgba(43, 38, 32, 0.10);
  }

  .card-art {
    width: 100%;
    aspect-ratio: 16 / 9;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .card-art.a { background: linear-gradient(135deg, var(--coral-soft), var(--gold-soft)); }
  .card-art.b { background: linear-gradient(135deg, var(--gold-soft), var(--silver-light)); }
  .card-art.c { background: linear-gradient(135deg, var(--silver-light), var(--coral-soft)); }

  .card-body {
    padding: 22px 22px 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
  }
  .card-body h4 { font-size: 1.06rem; line-height: 1.35; }
  .card-body p { color: var(--ink-soft); font-size: 0.93rem; margin: 0; flex: 1; }

  .card-link {
    font-weight: 600;
    font-size: 0.88rem;
    color: var(--coral);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 4px;
  }
  .card-link::after { content: "→"; transition: transform 0.15s; }
  .card-link:hover::after { transform: translateX(3px); }

  /* ---------- Wave dividers ---------- */

  .wave { display: block; width: 100%; height: 52px; }

  /* ---------- Stages section ---------- */

  .stages { background: var(--tan-deep); padding: 20px 0 72px; }

  .stages-intro { max-width: 640px; color: var(--ink-soft); margin-bottom: 36px; }

  .stage-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
    gap: 26px;
  }

  .stage {
    background: var(--white);
    border-radius: var(--radius);
    padding: 30px 28px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .stage-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .stage h4 { font-size: 1.35rem; margin: 0; }

  .status {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 5px 12px;
    border-radius: 999px;
    white-space: nowrap;
  }
  .status.live { background: var(--gold-soft); color: #6d5615; }
  .status.soon { background: var(--tan); color: var(--ink-soft); }

  .stage p { color: var(--ink-soft); font-size: 0.94rem; margin: 0; }

  .stage ul { list-style: none; margin: 4px 0 0; padding: 0; display: flex; flex-direction: column; gap: 9px; }
  .stage li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.92rem;
    color: var(--ink);
  }
  .stage li .dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
  .dot.coral { background: var(--coral); }
  .dot.gold { background: var(--gold); }
  .dot.silver { background: var(--silver); }

  .chip-row { display: flex; flex-wrap: wrap; gap: 9px; margin-top: 6px; }
  .chip {
    border: 1.5px solid var(--silver-light);
    background: var(--tan);
    color: var(--ink-soft);
    font-family: 'Source Sans 3', sans-serif;
    font-size: 0.85rem;
    font-weight: 600;
    padding: 7px 15px;
    border-radius: 999px;
    cursor: pointer;
    transition: background 0.18s, border-color 0.18s, color 0.18s;
  }
  .chip:hover { border-color: var(--gold); color: var(--coral); }
  .chip.on { background: var(--coral); border-color: var(--coral); color: var(--white); }
  .chip-note { font-size: 0.82rem; color: var(--silver); margin: 8px 0 0; min-height: 1.2em; }

  /* ---------- Killer app section ---------- */

  .killer { padding: 72px 0 76px; }

  .killer-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 54px;
    align-items: start;
  }

  .killer-copy p { color: var(--ink-soft); }
  .killer-copy .big { font-size: 1.06rem; }

  .poll {
    background: var(--white);
    border-radius: var(--radius);
    padding: 30px 28px;
    box-shadow: 0 2px 10px rgba(43, 38, 32, 0.06);
  }
  .poll h4 { font-size: 1.15rem; margin-bottom: 16px; }
  .poll-opts { display: flex; flex-direction: column; gap: 11px; }
  .poll-btn {
    text-align: left;
    font-family: 'Source Sans 3', sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--ink);
    background: var(--tan);
    border: 2px solid transparent;
    border-radius: 14px;
    padding: 14px 18px;
    cursor: pointer;
    transition: border-color 0.18s, background 0.18s, transform 0.12s;
  }
  .poll-btn:hover { border-color: var(--gold); transform: translateY(-1px); }
  .poll-btn.picked { border-color: var(--coral); background: #F9EFEA; color: var(--coral); }
  .poll-msg { margin: 16px 0 0; font-size: 0.9rem; color: var(--ink-soft); min-height: 1.4em; }

  /* ---------- Founder section ---------- */

  .founder { background: var(--tan-deep); padding: 24px 0 72px; }

  .founder-card {
    background: var(--white);
    border-radius: var(--radius);
    padding: 44px 48px;
    max-width: 820px;
    box-shadow: 0 2px 10px rgba(43, 38, 32, 0.05);
  }
  .founder-card h3 { font-size: 1.7rem; }
  .founder-card p { color: var(--ink-soft); }
  .founder-card .sig {
    margin-top: 18px;
    font-family: 'Fraunces', serif;
    font-size: 1.05rem;
    color: var(--ink);
  }
  .founder-card .sig span { display: block; font-family: 'Source Sans 3', sans-serif; font-size: 0.85rem; color: var(--silver); }

  /* ---------- Newsletter band ---------- */

  .join-band { padding: 72px 0; text-align: center; }
  .join-band h3 { font-size: clamp(1.6rem, 3vw, 2.1rem); max-width: 640px; margin: 0 auto 14px; }
  .join-band p { color: var(--ink-soft); max-width: 520px; margin: 0 auto 26px; }

  /* ---------- Footer ---------- */

  footer { padding: 30px 0 42px; text-align: center; border-top: 1px solid var(--silver-light); }
  footer p { color: var(--ink-soft); font-size: 0.9rem; margin: 4px 0; }
  .social-row { display: flex; justify-content: center; gap: 16px; margin: 18px 0; }
  .social-row a {
    width: 38px; height: 38px;
    border-radius: 50%;
    background: var(--tan-deep);
    display: flex; align-items: center; justify-content: center;
    color: var(--coral);
    font-size: 0.85rem; font-weight: 700;
    transition: background 0.2s, color 0.2s;
  }
  .social-row a:hover { background: var(--coral); color: var(--white); }
  footer .fine { color: var(--silver); font-size: 0.82rem; }

  @media (max-width: 860px) {
    .killer-grid { grid-template-columns: 1fr; gap: 34px; }
    .founder-card { padding: 34px 28px; }
  }
  @media (max-width: 640px) {
    nav ul { gap: 16px; row-gap: 10px; }
    .hero { padding: 46px 0 44px; }
    .hero-net { opacity: 0.5; }
  }

  @media (prefers-reduced-motion: reduce) {
    * { transition: none !important; scroll-behavior: auto !important; }
  }
</style>
</head>
<body>

<header>
  <div class="wrap header-row">
    <div class="brand">
      <svg class="brand-mark" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="BrainsConnected mark">
