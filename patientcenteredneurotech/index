":{},"hidden":false},"content":[{"type":"cardLayoutItem","attrs":{"itemId":"body"},"content":[{"type":"heading","attrs":{"level":1},"content":[{"type":"text","text":"Cross-Condition, Brain Health \u0026 International Organizations"}]},{"type":"gridLayout","attrs":{"colWidths":[50,50]},"content":[{"type":"gridCell","content":[{"type":"heading","attrs":{"level":4},"content":[{"type":"text","text":"Cross-Condition \u0026 Brain Health"}]},{"type":"smartLayout","attrs":{"variantKey":"arrowBullets","options":{"cellSize":15}},"content":[{"type":"smartLayoutCell","attrs":{"id":"BPhzF","options":{},"image":{"source":"image.icon","src":"https://cdn-staging.gamma.app/_app_static/icons/v0/arrow-right.svg"}},"content":[{"type":"heading","attrs":{"level":4},"content":[{"type":"text","text":"One Mind","marks":[{"type":"link","attrs":{"href":"https://onemind.org","source":null,"thumbnail":null,"embed":null,"meta":null}}]}]},{"type":"paragraph","content":[{"type":"text","text":"Accelerates brain health innovations through open science, data sharing, and cross-sector partnerships. Relevant for convening role and emphasis on lived experience data access."}]}]},{"type":"smartLayoutCell","attrs":{"id":"y4Wji","options":{},"image":{"source":"image.icon","src":"https://cdn-staging.gamma.app/_app_static/icons/v0/arrow-right.svg"}},"content":[{"type":"heading","attrs":{"level":4},"content":[{"type":"text","text":"BrainMind","marks":[{"type":"link","attrs":{"href":"https://brainmind.org","source":null,"thumbnail":null,"embed":null,"meta":null}}]}]},{"type":"paragraph","content":[{"type":"text","text":"A network of neuroscientists, founders, investors, and patients focused on ethical leadership and investment in neurotech ventures. Hosts multidisciplinary gatherings."}]}]},{"type":"smartLayoutCell","attrs":{"id":"sb-jY","options":{},"image":{"source":"image.icon","src":"https://cdn-staging.gamma.app/_app_static/icons/v0/arrow-right.svg"}},"content":[{"type":"heading","attrs":{"level":4},"content":[{"type":"text","text":"NeuroTech Institute","marks":[{"type":"link","attrs":{"href":"https://neurotechinstitute.org","source":null,"thumbnail":null,"embed":null,"meta":null}}]}]},{"type":"paragraph","content":[{"type":"text","text":"Features a patient-centered development model explicitly integrating individuals with lived experience into neurotech design and translation. Elevates patient voices alongside engineers and clinicians."}]}]}]}]},{"type":"gridCell","content":[{"type":"heading","attrs":{"level":4},"content":[{"type":"text","text":"International \u0026 Global Bodies"}]},{"type":"smartLayout","attrs":{"variantKey":"arrowBullets","options":{"cellSize":15}},"content":[{"type":"smartLayoutCell","attrs":{"id":"9Riic","options":{},"image":{"source":"image.icon","src":"https://cdn-staging.gamma.app/_app_static/icons/v0/arrow-right.svg"}},"content":[{"type":"heading","attrs":{"level":4},"content":[{"type":"text","text":"OneNeurology","marks":[{"type":"link","attrs":{"href":"https://oneneurology.net","source":null,"thumbnail":null,"embed":null,"meta":null}}]},{"type":"text","text":" \u0026 "},{"type":"text","text":"EFNA","marks":[{"type":"link","attrs":{"href":"https://www.efna.net","source":null,"thumbnail":null,"embed":null,"meta":null}}]}]},{"type":"paragraph","content":[{"type":"text","text":"OneNeurology connects lived experience advocates with global policymakers. The European Federation of Neurological Associations provides structured patient representation in EU neuroscience and regulatory discussions."}]}]},{"type":"smartLayoutCell","attrs":{"id":"zJcL5","options":{},"image":{"source":"image.icon","src":"https://cdn-staging.gamma.app/_app_static/icons/v0/arrow-right.svg"}},"content":[{"type":"heading","attrs":{"level":4},"content":[{"type":"text","text":"EURORDIS","marks":[{"type":"link","attrs":{"href":"https://www.eurordis.org","source":null,"thumbnail":null,"embed":null,"meta":null}}]},{"type":"text","text":" \u0026 "},{"type":"text","text":"European Patients' Forum","marks":[{"type":"link","attrs":{"href":"https://www.eu-patient.eu","source":null,"thumbnail":null,"embed":null,"meta":null}}]}]},{"type":"paragraph","content":[{"type":"text","text":"EURORDIS connects rare disease communities including neurological disorders. The European Patients' Forum bridges patients and policymakers on digital health and medical device regulation."}]}]},{"type":"smartLayoutCell","attrs":{"id":"nC6_L","options":{},"image":{"source":"image.icon","src":"https://cdn-staging.gamma.app/_app_static/icons/v0/arrow-right.svg"}},"content":[{"type":"heading","attrs":{"level":4},"content":[{"type":"text","text":"NeuroTech-NL","marks":[{"type":"link","attrs":{"href":"https://neurotechnl.nl","source":null,"thumbnail":null,"embed":null,"meta":null}}]},{"type":"text","text":" \u0026 "},{"type":"text","text":"ILAE","marks":[{"type":"link","attrs":{"href":"https://www.ilae.org","source":null,"thumbnail":null,"embed":null,"meta":null}}]}]},{"type":"paragraph","content":[{"type":"text","text":"The Dutch Neurotechnology Consortium co-develops neurotech with patients through living field labs. ILAE drives global epilepsy diagnostics standards and neuromodulation research frameworks."}]}]}]}]}]}]}]},{"type":"card","attrs":{"id":"33phc026jz41ehl","background":{"type":"none"},"container":{},"cardSize":"contained","layout":"blank","cardMarginSettings":{},"hidden":false},"content":[{"type":"cardLayoutItem","attrs":{"itemId":"body"},"content":[{"type":"heading","attrs":{"level":1},"content":[{"type":"text","text":"Human Factors Standards for Neurotechnology"}]},{"type":"paragraph","content":[{"type":"text","text":"Human factors and usability engineering are core components of medical device development — not optional downstream considerations. In neurotechnology, these issues are especially consequential because devices may interact with vulnerable patient populations, involve chronic or permanent implantation, require caregiver participation, or depend on reliable use under cognitively, emotionally, or physically demanding conditions."}]},{"type":"calloutBox","attrs":{"variant":"warning","icon":true},"content":[{"type":"paragraph","content":[{"type":"text","text":"Compliance with applicable human factors standards is expected in regulatory submissions and is evaluated by FDA reviewers and notified bodies."}]}]},{"type":"smartLayout","attrs":{"variantKey":"outlineBoxesWithLabel","options":{"cellSize":20,"numbered":true}},"content":[{"type":"smartLayoutCell","attrs":{"id":"GJM0V","options":{}},"content":[{"type":"heading","attrs":{"level":4},"content":[{"type":"text","text":"FDA HF Guidance (2016)","marks":[{"type":"link","attrs":{"href":"https://www.fda.gov/media/74846/download","source":null,"thumbnail":null,"embed":null,"meta":null}}]}]},{"type":"paragraph","content":[{"type":"text","text":"FDA's primary guidance on applying usability engineering in device submissions. Explains documentation requirements and how to structure summative validation testing. Directly applicable to 510(k), De Novo, and PMA submissions."}]}]},{"type":"smartLayoutCell","attrs":{"id":"l8BV_","options":{}},"content":[{"type":"heading","attrs":{"level":4},"content":[{"type":"text","text":"FDA HF \u0026 Clinical Studies (2014)","marks":[{"type":"link","attrs":{"href":"https://www.fda.gov/media/89866/download","source":null,"thumbnail":null,"embed":null,"meta":null}}]}]},{"type":"paragraph","content":[{"type":"text","text":"Addresses the intersection of human factors testing and clinical study design. Relevant for developers designing pivotal studies where use-related endpoints are a component of the evidence package."}]}]},{"type":"smartLayoutCell","attrs":{"id":"_0Zv8","options":{}},"content":[{"type":"heading","attrs":{"level":4},"content":[{"type":"text","text":"IEC 62366-1:2015 + AMD1:2020","marks":[{"type":"link","attrs":{"href":"https://www.iso.org/standard/73007.html","source":null,"thumbnail":null,"embed":null,"meta":null}}]}]},{"type":"paragraph","content":[{"type":"text","text":"The principal international standard governing usability engineering in device design. Requires identification of intended users, use environments, and use-related risks; formative and summative usability testing; and documentation for regulatory submissions."}]}]},{"type":"smartLayoutCell","attrs":{"id":"brbJ3","options":{}},"content":[{"type":"heading","attrs":{"level":4},"content":[{"type":"text","text":"ISO 14971:2019","marks":[{"type":"link","attrs":{"href":"https://www.iso.org/standard/72704.html","source":null,"thumbnail":null,"embed":null,"meta":null}}]}]},{"type":"paragraph","content":[{"type":"text","text":"The foundational standard for medical device risk management. Explicitly requires manufacturers to include patient harm in the risk calculus and consider the acceptability of residual risks from the patient perspective — critical for irreversible neurotech harms."}]}]}]},{"type":"gridLayout","attrs":{"colWidths":[33.33,33.33,33.33]},"content":[{"type":"gridCell","content":[{"type":"heading","attrs":{"level":4},"content":[{"type":"text","text":"ISO 9241 Series","marks":[{"type":"link","attrs":{"href":"https://www.iso.org/standard/52075.html","source":null,"thumbnail":null,"embed":null,"meta":null}}]}]},{"type":"paragraph","content":[{"type":"text","text":"Ergonomics of human-system interaction. Relevant parts include ISO 9241-11 (usability definitions and framework) and ISO 9241-210 (human-centered design process). These standards provide the conceptual foundation that IEC 62366-1 builds upon."}]}]},{"type":"gridCell","content":[{"type":"heading","attrs":{"level":4},"content":[{"type":"text","text":"ANSI/AAMI HE75:2009","marks":[{"type":"link","attrs":{"href":"https://www.aami.org/detail-pages/store/product-detail/he75-2009-r2018","source":null,"thumbnail":null,"embed":null,"meta":null}}]}]},{"type":"paragraph","content":[{"type":"text","text":"A detailed reference standard providing comprehensive guidance on applying human factors methods throughout the device development lifecycle. Useful for development teams building internal processes consistent with FDA expectations."}]}]},{"type":"gridCell","content":[{"type":"heading","attrs":{"level":4},"content":[{"type":"text","text":"FDA Patient Preference Information (PPI)","marks":[{"type":"link","attrs":{"href":"https://www.fda.gov/medical-devices/science-and-research-medical-devices/patient-preference-information","source":null,"thumbnail":null,"embed":null,"meta":null}}]}]},{"type":"paragraph","content":[{"type":"text","text":"An FDA initiative incorporating patient-defined benefit-risk thresholds into device regulatory submissions. For neurotech devices — where patients trade function, risk, and quality of life — PPI provides the structured mechanism for documenting patient-centered benefit-risk assessment."}]}]}]}]}]},{"type":"card","attrs":{"id":"bdmdkas1nh72tm3","background":{"type":"none"},"container":{},"cardSize":"contained","layout":"blank","cardMarginSettings":{},"hidden":false},"content":[{"type":"cardLayoutItem","attrs":{"itemId":"body"},"content":[{"type":"heading","attrs":{"level":1},"content":[{"type":"text","text":"Patient Engagement Frameworks \u0026 Lived Experience Resources"}]},{"type":"paragraph","content":[{"type":"text","text":"Meaningful patient engagement requires more than informal feedback or occasional consultation. Structured frameworks help development teams distinguish genuine incorporation of patient perspective from symbolic inclusion, and provide documentation infrastructure that supports regulatory and investor scrutiny."}]},{"type":"smartLayout","attrs":{"variantKey":"solidBoxesWithIconsInside","options":{"cellSize":20}},"content":[{"type":"smartLayoutCell","attrs":{"id":"TRx7E","options":{},"image":{"loadImageParams":{"provider":"icon","query":"government building","options":{"license":"All"}},"loadImageStatus":"done","loadImageId":"Iual0","src":"https://iconscdn.pictographic.ai/image/0OPGBDqXRtEDcZCNmaX7.svg?stroke=45","tempUrl":"https://iconscdn.pictographic.ai/image/0OPGBDqXRtEDcZCNmaX7.svg?stroke=45","meta":{"description":"Two flags on either side of a building, symbolizing international relations and diplomatic representation."},"query":"government building","source":"image.pictographic.icon","uploadStatus":3}},"content":[{"type":"heading","attrs":{"level":4},"content":[{"type":"text","text":"FDA PEAC \u0026 Patient Science Program","marks":[{"type":"link","attrs":{"href":"https://www.fda.gov/patients/learn-about-fdas-patient-engagement-activities/patient-engagement-advisory-committee-peac","source":null,"thumbnail":null,"embed":null,"meta":null}}]}]},{"type":"paragraph","content":[{"type":"text","text":"The Patient Engagement Advisory Committee provides FDA with input from patient and caregiver perspectives on device review. The Patient Science and Engagement Program incorporates patient perspectives across the device development lifecycle."}]}]},{"type":"smartLayoutCell","attrs":{"id":"ZG1RE","options":{},"image":{"loadImageParams":{"provider":"icon","query":"checklist rubric","options":{"license":"All"}},"loadImageStatus":"done","loadImageId":"aeubD","src":"https://iconscdn.pictographic.ai/image/JsMqOf3DFBai6iYGdRnG.svg?stroke=45","tempUrl":"https://iconscdn.pictographic.ai/image/JsMqOf3DFBai6iYGdRnG.svg?stroke=45","meta":{"description":"A black square in a white background, embodying the concept of a rubric, symbolizing evaluation, assessment, and grading criteria."},"query":"checklist rubric","source":"image.pictographic.icon","uploadStatus":3}},"content":[{"type":"heading","attrs":{"level":4},"content":[{"type":"text","text":"PCORI Engagement Rubric","marks":[{"type":"link","attrs":{"href":"https://www.pcori.org/engagement/engagement-in-research/engagement-rubric","source":null,"thumbnail":null,"embed":null,"meta":null}}]}]},{"type":"paragraph","content":[{"type":"text","text":"A structured framework for planning and evaluating patient and stakeholder engagement in research. Provides concrete criteria across engagement activities and a common language for describing engagement quality — useful as an internal benchmark and for communicating rigor to investors and regulators."}]}]},{"type":"smartLayoutCell","attrs":{"id":"htt63","options":{},"image":{"loadImageParams":{"provider":"icon","query":"brain ethics compass","options":{"license":"All"}},"loadImageStatus":"done","loadImageId":"hdZSN","src":"https://iconscdn.pictographic.ai/image/6EMg7gxGgDKokh4fAwe2Dr.svg?stroke=45","tempUrl":"https://iconscdn.pictographic.ai/image/6EMg7gxGgDKokh4fAwe2Dr.svg?stroke=45","meta":{"description":"A rounded shape with a narrow part at the top and a wider part at the bottom, resembling the human head, symbolizing the brain and its functions."},"query":"brain ethics compass","source":"image.pictographic.icon","uploadStatus":3}},"content":[{"type":"heading","attrs":{"level":4},"content":[{"type":"text","text":"Asilomar Lived Experience Rubric (BrainMind)","marks":[{"type":"link","attrs":{"href":"https://brainmind.org","source":null,"thumbnail":null,"embed":null,"meta":null}}]}]},{"type":"paragraph","content":[{"type":"text","text":"A field-specific framework guiding lived experience engagement in neurotechnology and brain health research. Calibrated to the specific dynamics of the neurotech sector, including the sensitivity of neural data and the complexity of patient populations."}]}]},{"type":"smartLayoutCell","attrs":{"id":"qbZSZ","options":{},"image":{"loadImageParams":{"provider":"icon","query":"toolkit resources","options":{"license":"All"}},"loadImageStatus":"done","loadImageId":"VgoJJ","src":"https://iconscdn.pictographic.ai/image/FVYlgGMTW9sq9Fe8NsGx.svg?stroke=45","tempUrl":"https://iconscdn.pictographic.ai/image/FVYlgGMTW9sq9Fe8NsGx.svg?stroke=45","meta":{"description":"Two simplified humanoid figures side by side, often used to symbolize partnership, teamwork, or human resources."},"query":"toolkit resources","source":"image.pictographic.icon","uploadStatus":3}},"content":[{"type":"heading","attrs":{"level":4},"content":[{"type":"text","text":"MDIC Center for Evidence \u0026 Patient Engagement","marks":[{"type":"link","attrs":{"href":"https://mdic.org/program/patient-centered-clinical-trials/","source":null,"thumbnail":null,"embed":null,"meta":null}}]}]},{"type":"paragraph","content":[{"type":"text","text":"A center for neurotech experts and patients to collaborate throughout the device lifecycle. Resources include the Patient Engagement Estimation Tool, a roadmap to lived experience engagement in early device development, and best practices for engaging patients in clinical research."}]}]}]},{"type":"smartLayout","attrs":{"variantKey":"processSteps","options":{"cellSize":20,"numbered":true}},"content":[{"type":"smartLayoutCell","attrs":{"id":"4SsfU","options":{}},"content":[{"type":"heading","attrs":{"level":4},"content":[{"type":"text","text":"INVOLVE (UK NIHR)","marks":[{"type":"link","attrs":{"href":"https://www.nihr.ac.uk/patients-and-public/documents/how-to-involve-the-public-in-your-research.pdf","source":null,"thumbnail":null,"embed":null,"meta":null}}]}]},{"type":"paragraph","content":[{"type":"text","text":"Publishes guidance, training materials, and case studies on structuring meaningful patient involvement. Particularly relevant for teams conducting multinational research or engaged with UK regulatory frameworks. "}]}]},{"type":"smartLayoutCell","attrs":{"id":"66k5C","options":{}},"content":[{"type":"heading","attrs":{"level":4},"content":[{"type":"text","text":"Wellcome Trust: Embedding Lived Experience","marks":[{"type":"link","attrs":{"href":"https://wellcome.org/grant-funding/guidance/public-engagement/embedding-lived-experience","source":null,"thumbnail":null,"embed":null,"meta":null}}]}]},{"type":"paragraph","content":[{"type":"text","text":"A guide to understanding the meaning, importance, and embedding of lived experience in mental health research. Includes considerations for appropriate engagement across various contexts. "}]}]},{"type":"smartLayoutCell","attrs":{"id":"_oQA8","options":{}},"content":[{"type":"heading","attrs":{"level":4},"content":[{"type":"text","text":"NeuroTech Course","marks":[{"type":"link","attrs":{"href":"https://www.neurotechcourse.org","source":null,"thumbnail":null,"embed":null,"meta":null}}]}]},{"type":"paragraph","content":[{"type":"text","text":"A free, online educational series covering the fundamentals of translating and commercializing neurotech, including a section on understanding the user perspective. Accompanied by bi-annual hands-on workshops and a practical handbook. "}]}]},{"type":"smartLayoutCell","attrs":{"id":"gIuy0","options":{}},"content":[{"type":"heading","attrs":{"level":4},"content":[{"type":"text","text":"National Health Council: Patient Engagement","marks":[{"type":"link","attrs":{"href":"https://nationalhealthcouncil.org/programs/patient-engagement/","source":null,"thumbnail":null,"embed":null,"meta":null}}]}]},{"type":"paragraph","content":[{"type":"text","text":"Features the Patient Experience Mapping Toolbox, Glossary of Patient Engagement Terms, and The Patient Engagement in Quality Measurement Rubric for managing proper engagement of lived experience in neurotech research. "}]}]}]}]}]},{"type":"card","attrs":{"id":"0d79z7cdelnucp9","background":{"type":"none"},"container":{},"cardSize":"default","layout":"blank","cardMarginSettings":{},"hidden":false},"content":[{"type":"cardLayoutItem","attrs":{"itemId":"body"},"content":[{"type":"heading","attrs":{"level":1},"content":[{"type":"text","text":"Neural Data Governance \u0026 Patient Rights"}]},{"type":"paragraph","content":[{"type":"text","text":"Neural data collected from patients and device users carries unique sensitivity that existing health privacy frameworks were not designed to address. Unlike general health data, neural recordings can reveal cognitive states, mental health status, emotional patterns, and in some contexts, predictive information about future behavior."}]},{"type":"calloutBox","attrs":{"variant":"info","icon":true},"content":[{"type":"paragraph","content":[{"type":"text","text":"Neurotechnology developers should treat neural data governance as an active design and policy area rather than a compliance box to check late in development."}]}]},{"type":"gridLayout","attrs":{"colWidths":[50,50]},"content":[{"type":"gridCell","attrs":{"backgroundColor":"#11241d"},"content":[{"type":"heading","attrs":{"level":4},"content":[{"type":"text","text":"Federal Baseline"}]},{"type":"bullet","attrs":{"indent":0},"content":[{"type":"text","text":"HIPAA (1996)","marks":[{"type":"bold","attrs":{}},{"type":"link","attrs":{"href":"https://www.hhs.gov/hipaa/index.html","source":null,"thumbnail":null,"embed":null,"meta":null}}]},{"type":"text","text":" — Establishes national rules for privacy and security of protected health information. Many consumer neurotech products fall outside HIPAA's scope — a regulatory gap that state-level legislation is beginning to address."}]},{"type":"bullet","attrs":{"indent":0},"content":[{"type":"text","text":"21 CFR Part 50","marks":[{"type":"bold","attrs":{}},{"type":"link","attrs":{"href":"https://www.ecfr.gov/current/title-21/chapter-I/subchapter-A/part-50","source":null,"thumbnail":null,"embed":null,"meta":null}}]},{"type":"text","text":" — FDA regulations governing informed consent for human subjects in device research. Sets the legal floor for patient autonomy and defines what participants must be told before enrolling in device trials."}]},{"type":"bullet","attrs":{"indent":0},"content":[{"type":"text","text":"FDA Patient Science \u0026 Engagement Program","marks":[{"type":"bold","attrs":{}},{"type":"link","attrs":{"href":"https://www.fda.gov/patients/learn-about-fdas-patient-engagement-activities/patient-science-and-engagement-program","source":null,"thumbnail":null,"embed":null,"meta":null}}]},{"type":"text","text":" — Addresses patient perspectives in FDA regulatory decision-making, including how patient-reported data can be incorporated into device submissions."}]}]},{"type":"gridCell","content":[{"type":"heading","attrs":{"level":4},"content":[{"type":"text","text":"State-Level Neural Data Legislation"}]},{"type":"paragraph","content":[{"type":"text","text":"Several U.S. states have passed or are actively developing neural data-specific privacy legislation that goes beyond HIPAA. This landscape is evolving rapidly."}]},{"type":"bullet","attrs":{"indent":0},"content":[{"type":"text","text":"Colorado AI Act and Neural Data Provisions","marks":[{"type":"bold","attrs":{}},{"type":"link","attrs":{"href":"https://leg.colorado.gov/bills/sb24-205","source":null,"thumbnail":null,"embed":null,"meta":null}}]},{"type":"text","text":" — Specifically addresses neural data as a protected category, with requirements applying to companies collecting brain signals from Colorado residents. Being tracked by other jurisdictions as a potential model."}]},{"type":"bullet","attrs":{"indent":0},"content":[{"type":"text","text":"California Delete Act \u0026 Related Privacy Frameworks","marks":[{"type":"bold","attrs":{}},{"type":"link","attrs":{"href":"https://oag.ca.gov/privacy/ccpa","source":null,"thumbnail":null,"embed":null,"meta":null}}]},{"type":"text","text":" — California's comprehensive consumer privacy infrastructure (CCPA and amendments) creates obligations for companies collecting sensitive personal data including health and biometric information."}]}]}]},{"type":"smartLayout","attrs":{"variantKey":"solidLeafBoxes","options":{"cellSize":15}},"content":[{"type":"smartLayoutCell","attrs":{"id":"-1deZ","options":{}},"content":[{"type":"heading","attrs":{"level":4},"content":[{"type":"text","text":"UNESCO Recommendation on Ethics of Neurotechnology (2024)","marks":[{"type":"link","attrs":{"href":"http://unesco.org","source":null,"thumbnail":null,"embed":null,"meta":null}}]}]},{"type":"paragraph","content":[{"type":"text","text":"A landmark international policy document framing neural data protection as a human rights issue. Actively influencing national legislation globally, including in Chile, Spain, and other jurisdictions. Developers operating internationally should understand this framework and its downstream regulatory effects."}]}]},{"type":"smartLayoutCell","attrs":{"id":"Wb3ui","options":{}},"content":[{"type":"heading","attrs":{"level":4},"content":[{"type":"text","text":"EU MDR Article 10 (Post-Market Clinical Follow-Up)","marks":[{"type":"link","attrs":{"href":"http://eur-lex.europa.eu","source":null,"thumbnail":null,"embed":null,"meta":null}}]}]},{"type":"paragraph","content":[{"type":"text","text":"Requires ongoing monitoring of patient experience with CE-marked devices, including neurotechnology. Creates a continuous obligation to treat patient-reported information as an active data stream rather than a one-time consent event."}]}]},{"type":"smartLayoutCell","attrs":{"id":"-bDpk","options":{}},"content":[{"type":"heading","attrs":{"level":4},"content":[{"type":"text","text":"NeuroRights Foundation (Columbia University)","marks":[{"type":"link","attrs":{"href":"http://neurorightsfoundation.org","source":null,"thumbnail":null,"embed":null,"meta":null}}]}]},{"type":"paragraph","content":[{"type":"text","text":"The most widely cited patient-rights framework specific to neurotechnology. Five foundational neurorights: "},{"type":"text","text":"mental privacy, personal identity, free will, equal access, and protection from algorithmic bias","marks":[{"type":"bold","attrs":{}}]},{"type":"text","text":". Informing legislation in Chile and other jurisdictions. Developers should understand these as emerging normative expectations, not speculative future requirements."}]}]}]}]}]},{"type":"card","attrs":{"id":"rvv8no2zhp8yq41","background":{"type":"none"},"container":{},"cardSize":"default","layout":"blank","cardMarginSettings":{},"hidden":false},"content":[{"type":"cardLayoutItem","attrs":{"itemId":"body"},"content":[{"type":"heading","attrs":{"level":1},"content":[{"type":"text","text":"Clinical Trial Participation in Neurotechnology"}]},{"type":"paragraph","content":[{"type":"text","text":"Clinical trials are the mechanism by which neurotechnology moves from laboratory to patient. Without them, devices cannot demonstrate safety and effectiveness, cannot achieve regulatory clearance or approval, and cannot become accessible through insurance reimbursement to the people who need them most."}]},{"type":"gridLayout","attrs":{"colWidths":[50,50]},"content":[{"type":"gridCell","content":[{"type":"heading","attrs":{"level":4},"content":[{"type":"text","text":"Why Clinical Trials Matter"}]},{"type":"paragraph","content":[{"type":"text","text":"New neurotechnology treatments do not become standard of care without a structured evidence base. Regulators require clinical evidence of safety and effectiveness before granting clearance or approval. Payers — including Medicare, Medicaid, and private insurers — require evidence of clinical benefit before covering a device or procedure."}]},{"type":"paragraph","content":[{"type":"text","text":"This is particularly consequential in neurotechnology, where the gap between promising research and accessible, reimbursed treatment has historically been wide. Enrollment in clinical trials is often the binding constraint on how fast the field can advance."}]}]},{"type":"gridCell","content":[{"type":"heading","attrs":{"level":4},"content":[{"type":"text","text":"How Trials Are Regulated"}]},{"type":"paragraph","content":[{"type":"text","text":"Clinical trials involving medical devices operate under a framework designed to protect participants and ensure the integrity of evidence. In the United States, this includes:"}]},{"type":"bullet","attrs":{"indent":0},"content":[{"type":"text","text":"FDA oversight including Investigational Device Exemption requirements for significant risk devices"}]},{"type":"bullet","attrs":{"indent":0},"content":[{"type":"text","text":"Institutional Review Board review and approval"}]},{"type":"bullet","attrs":{"indent":0},"content":[{"type":"text","text":"Federal rules governing informed consent under 21 CFR Part 50"}]},{"type":"paragraph","content":[{"type":"text","text":"Internationally, equivalent frameworks apply under the EU Clinical Trials Regulation, ICH Good Clinical Practice guidelines, and jurisdiction-specific requirements."}]}]}]},{"type":"heading","attrs":{"level":4},"content":[{"type":"text","text":"How to Find Clinical Trials"}]},{"type":"smartLayout","attrs":{"variantKey":"iconsText","options":{"cellSize":"xl","imagePosition":"left"}},"content":[{"type":"smartLayoutCell","attrs":{"id":"_Pkd5","options":{},"image":{"loadImageParams":{"provider":"icon","query":"search database","options":{"license":"All"}},"loadImageStatus":"done","loadImageId":"j3NJg","src":"https://iconscdn.pictographic.ai/image/cZ83sbUUer9IJonnnfxB.svg?stroke=45","tempUrl":"https://iconscdn.pictographic.ai/image/cZ83sbUUer9IJonnnfxB.svg?stroke=45","meta":{"description":"Magnifying glass symbolizes the act of searching or looking for something closely, often used to represent investigation or examination."},"query":"search database","source":"image.pictographic.icon","uploadStatus":3}},"content":[{"type":"heading","attrs":{"level":4},"content":[{"type":"text","text":"ClinicalTrials.gov"}]},{"type":"paragraph","content":[{"type":"text","text":"The U.S. National Library of Medicine's registry of publicly and privately funded clinical studies worldwide. Searchable by condition, intervention type, location, and trial phase. The primary starting point for patients seeking neurotechnology trials."}]}]},{"type":"smartLayoutCell","attrs":{"id":"boHkv","options":{},"image":{"loadImageParams":{"provider":"icon","query":"company registry list","options":{"license":"All"}},"loadImageStatus":"done","loadImageId":"nsHCP","src":"https://iconscdn.pictographic.ai/image/gf76ZHyK85zcQiN58HXp.svg?stroke=45","tempUrl":"https://iconscdn.pictographic.ai/image/gf76ZHyK85zcQiN58HXp.svg?stroke=45","meta":{"description":"Three horizontal lines of different lengths stacked on top of each other, forming a minimalist symbol for a clipboard list, conveying organization and task management."},"query":"company registry list","source":"image.pictographic.icon","uploadStatus":3}},"content":[{"type":"heading","attrs":{"level":4},"content":[{"type":"text","text":"Company Patient Registries"}]},{"type":"paragraph","content":[{"type":"text","text":"Many neurotechnology companies maintain patient registries, interest lists, or early access programs separate from formal trial registration. Patients interested in a specific device or company should check the company's website directly or contact their clinical affairs team."}]}]},{"type":"smartLayoutCell","attrs":{"id":"-Jvvz","options":{},"image":{"loadImageParams":{"provider":"icon","query":"patient advocacy group meeting","options":{"license":"All"}},"loadImageStatus":"done","loadImageId":"oeASf","src":"https://iconscdn.pictographic.ai/image/f1wXSrDI3KGpwzYi3qrN.svg?stroke=45","tempUrl":"https://iconscdn.pictographic.ai/image/f1wXSrDI3KGpwzYi3qrN.svg?stroke=45","meta":{"description":"A person silhouette, symbolizing an individual receiving medical care or treatment, embodying the concept of a patient."},"query":"patient advocacy group meeting","source":"image.pictographic.icon","uploadStatus":3}},"content":[{"type":"heading","attrs":{"level":4},"content":[{"type":"text","text":"Patient Advocacy Organizations"}]},{"type":"paragraph","content":[{"type":"text","text":"Many organizations listed in this resource maintain trial matching resources, newsletters, or direct referral pathways. Organizations such as Neurotech Network and BCI Pioneers are active in connecting members to relevant research opportunities."}]}]}]},{"type":"calloutBox","attrs":{"variant":"note","icon":true},"content":[